{
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap-www.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/today", "destination": "/today/index.html" },
    { "source": "/practice", "destination": "/practice/index.html" },
    { "source": "/breathe", "destination": "/breathe/index.html" },
    { "source": "/heal", "destination": "/heal/index.html" },
    { "source": "/sleep", "destination": "/sleep/index.html" },
    { "source": "/journal", "destination": "/journal/index.html" },
    { "source": "/telehealth", "destination": "/telehealth/index.html" },
    { "source": "/therapy", "destination": "/therapy/index.html" },
    { "source": "/desk-clock", "destination": "/desk-clock/index.html" },
    { "source": "/standby", "destination": "/standby/index.html" },
    { "source": "/doombreaker", "destination": "/doombreaker/index.html" },
    { "source": "/companions", "destination": "/companions/index.html" },
    { "source": "/games", "destination": "/games/index.html" },
    { "source": "/soundboard", "destination": "/soundboard/index.html" },
    { "source": "/safety", "destination": "/safety/index.html" },
    { "source": "/themes", "destination": "/themes/index.html" },
    { "source": "/science", "destination": "/science/index.html" },
    { "source": "/lab", "destination": "/lab/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/downloads", "destination": "/downloads/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/privacy-policy/spycam-pro", "destination": "/privacy-policy/spycam-pro/index.html" },
    { "source": "/learn", "destination": "/learn/index.html" },
    { "source": "/learn/:slug", "destination": "/learn/:slug/index.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/sitemap-www.xml", "destination": "/sitemap-www.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
